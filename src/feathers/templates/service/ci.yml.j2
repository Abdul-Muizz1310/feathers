name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
      - run: uv python install {{ service.python }}
      # No --frozen: the generator does not emit a uv.lock. Run `uv lock`,
      # commit the lockfile, and add --frozen for fully reproducible CI.
      - run: uv sync --all-extras
      - run: uv run python -c "import {{ service.snake }}"

  test:
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
      - run: uv python install {{ service.python }}
      # No --frozen: the generator does not emit a uv.lock. Run `uv lock`,
      # commit the lockfile, and add --frozen for fully reproducible CI.
      - run: uv sync --all-extras
      - run: uv run pytest

  build:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
      - run: uv python install {{ service.python }}
      # No --frozen: the generator does not emit a uv.lock. Run `uv lock`,
      # commit the lockfile, and add --frozen for fully reproducible CI.
      - run: uv sync --all-extras
      - run: uv build

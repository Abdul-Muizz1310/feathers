[project]
name = "{{ service.snake }}"
version = "0.1.0"
description = "{{ service.description }}"
readme = "README.md"
requires-python = ">={{ service.python }}"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.32",
    "pydantic>=2.9",
    "pydantic-settings>=2.6",
    "sqlalchemy[asyncio]>=2.0.36",
    "aiosqlite>=0.20",
    "asyncpg>=0.30",
    "alembic>=1.14",
{% if observability.logging == "structlog" %}    "structlog>=24.4",
{% endif %}{% if observability.metrics == "prometheus" %}    "prometheus-fastapi-instrumentator>=7.0",
{% endif %}    "pyjwt[crypto]>=2.9",
    "httpx>=0.27",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.3",
]

[build-system]
requires = ["hatchling>=1.25"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ service.snake }}"]

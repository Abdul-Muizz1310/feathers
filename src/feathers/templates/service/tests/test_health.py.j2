"""Liveness and version, and the test database's isolation."""

from __future__ import annotations

from pathlib import Path

from fastapi.testclient import TestClient

from {{ service.snake }}.core.config import settings
from {{ service.snake }}.main import app

client = TestClient(app)


def test_health_ok() -> None:
    resp = client.get("/health")
    assert resp.status_code == 200
    body = resp.json()
    assert body["status"] == "ok"
    assert body["service"] == "{{ service.snake }}"
    assert body["db"] == "ok"
    assert "commit_sha" in body


def test_version_ok() -> None:
    body = client.get("/version").json()
    assert body["service"] == "{{ service.snake }}"
    assert "version" in body
{%- if observability.metrics == "prometheus" %}


def test_metrics_ok() -> None:
    resp = client.get("/metrics")
    assert resp.status_code == 200
{%- endif %}


def test_suite_database_is_isolated_from_the_working_directory() -> None:
    """With no DATABASE_URL the service would write ./{{ service.snake }}.db and keep
    rows between runs; the test session must use its own temp database instead."""
    assert "{{ service.snake }}.db" not in settings.database_url
    with TestClient(app) as isolated:
        assert isolated.get("/health").json()["db"] == "ok"
    assert not (Path.cwd() / "{{ service.snake }}.db").exists()

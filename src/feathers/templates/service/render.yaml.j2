services:
  - type: web
    name: {{ service.snake }}
    runtime: docker
    plan: free
    healthCheckPath: {{ deploy.health }}
    # The Docker image installs deps with pip (no uv is present), so alembic is
    # on PATH and is invoked directly here.
    preDeployCommand: alembic upgrade head
    envVars:
      - key: PORT
        value: "8000"
      - key: DATABASE_URL
        sync: false
      # bastion's Ed25519 public key (base64 SPKI DER). Without it every protected
      # route answers 503 (platform token contract v2 fails closed).
      - key: BASTION_SIGNING_KEY_PUBLIC
        sync: false

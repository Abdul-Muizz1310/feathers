"""Async repository for {{ model.name }} — all {{ model.name }} database access."""

from __future__ import annotations

{% if model.soft_delete %}from datetime import UTC, datetime
{% endif %}from typing import Any
{% if model.pk.py_type == "UUID" %}from uuid import UUID
{% endif %}
{% if model.offset_list or model.cursor_list %}from sqlalchemy import select
{% endif %}from sqlalchemy.ext.asyncio import AsyncSession

from {{ service.snake }}.models.{{ model.snake }} import {{ model.name }}


async def create(
    session: AsyncSession,
    data: dict[str, Any],
) -> {{ model.name }}:
    """Insert a {{ model.name }} and return it (server defaults loaded)."""
    obj = {{ model.name }}(**data)
    session.add(obj)
    await session.flush()
    await session.refresh(obj)
    return obj


async def _live(
    session: AsyncSession,
    {{ model.pk.name }}: {{ model.pk.py_type }},
) -> {{ model.name }} | None:
{%- if model.soft_delete %}
    """Fetch a live {{ model.name }} by primary key, or None.

    The single primary-key lookup every CRUD path goes through, so none of them can
    forget the soft-delete filter: once ``deleted_at`` is set the row is retained in
    the database but is indistinguishable from absent to readers and writers alike.
    """
{%- else %}
    """Fetch a {{ model.name }} by primary key, or None."""
{%- endif %}
    obj = await session.get({{ model.name }}, {{ model.pk.name }})
{%- if model.soft_delete %}
    if obj is not None and obj.deleted_at is not None:
        return None
{%- endif %}
    return obj


async def get(
    session: AsyncSession,
    {{ model.pk.name }}: {{ model.pk.py_type }},
) -> {{ model.name }} | None:
    """Fetch a {{ model.name }} by primary key, or None."""
    return await _live(session, {{ model.pk.name }})
{%- if model.offset_list or model.cursor_list %}


# A hard ceiling on how many rows a single list query may return, enforced in
# the repository so no caller (router bound or otherwise) can exhaust memory.
MAX_LIMIT = 100


def _clamp_limit(limit: int) -> int:
    return max(1, min(limit, MAX_LIMIT))
{%- endif %}
{%- if model.offset_list %}


async def list_all(
    session: AsyncSession,
    *,
    limit: int = 50,
    offset: int = 0,
) -> list[{{ model.name }}]:
    """List {{ model.plural_snake }} by primary key, ``offset`` rows in (limit capped)."""
    stmt = select({{ model.name }})
{%- if model.soft_delete %}
    stmt = stmt.where({{ model.name }}.deleted_at.is_(None))
{%- endif %}
    stmt = stmt.order_by({{ model.name }}.{{ model.pk.name }})
    stmt = stmt.limit(_clamp_limit(limit)).offset(max(0, offset))
    return list((await session.scalars(stmt)).all())
{%- endif %}
{%- if model.cursor_list %}


async def list_after(
    session: AsyncSession,
    *,
    cursor: {{ model.pk.py_type }} | None = None,
    limit: int = 50,
) -> list[{{ model.name }}]:
    """List {{ model.plural_snake }} after the ``cursor`` primary key (keyset; limit capped)."""
    stmt = select({{ model.name }})
{%- if model.soft_delete %}
    stmt = stmt.where({{ model.name }}.deleted_at.is_(None))
{%- endif %}
    if cursor is not None:
        stmt = stmt.where({{ model.name }}.{{ model.pk.name }} > cursor)
    stmt = stmt.order_by({{ model.name }}.{{ model.pk.name }})
    stmt = stmt.limit(_clamp_limit(limit))
    return list((await session.scalars(stmt)).all())
{%- endif %}


async def update(
    session: AsyncSession,
    {{ model.pk.name }}: {{ model.pk.py_type }},
    data: dict[str, Any],
) -> {{ model.name }} | None:
    """Apply a partial update; None when the row is absent{% if model.soft_delete %} or soft-deleted{% endif %}."""
    obj = await _live(session, {{ model.pk.name }})
    if obj is None:
        return None
    for key, value in data.items():
        setattr(obj, key, value)
    await session.flush()
    await session.refresh(obj)
    return obj


async def delete(
    session: AsyncSession,
    {{ model.pk.name }}: {{ model.pk.py_type }},
) -> bool:
    """{% if model.soft_delete %}Soft-delete{% else %}Delete{% endif %} a {{ model.name }}; False when it is absent{% if model.soft_delete %} or already deleted{% endif %}."""
{%- if model.soft_delete %}
    obj = await _live(session, {{ model.pk.name }})
    if obj is None:
        return False
    obj.deleted_at = datetime.now(UTC)
{%- else %}
    obj = await _live(session, {{ model.pk.name }})
    if obj is None:
        return False
    await session.delete(obj)
{%- endif %}
    await session.flush()
    return True

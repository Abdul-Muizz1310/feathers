    {{ model.pk.name }}: {{ model.pk.py_type }}, session: AsyncSession = Depends(get_session)
) -> None:
    """{{ ep.method }} {{ ep.path }}"""
    if not await service.delete(session, {{ model.pk.name }}):
        raise HTTPException(status_code=404, detail="{{ model.name }} not found")
